# Copy to repro/env (gitignored) and fill in. Everything environment-specific lives here; the scripts never need editing.
# Credentials: point at files or CLI profiles; don't paste secrets here.
# The offline scenarios (unit, headers, errors, precheck, stopfailure) need none of this.

# Claude Code to test (default: `claude` on PATH). Pin a version with e.g. `npm i --prefix ~/cc-2.1.286 @anthropic-ai/claude-code@2.1.286`.
CLAUDE_BIN=
# Model the test turns ask for (any model your Anthropic plan and the gateway allow).
MODEL=claude-haiku-4-5

# A Claude Code config dir holding a stored `claude login` (CLAUDE_CONFIG_DIR=<dir> claude, then /login).
# Use a dedicated one: the stored_login, live_login and client_live scenarios rotate this login at Anthropic and
# temporarily replace the settings.json in it (restored afterwards).
LOGIN_CONFIG_DIR=

# The AI gateway's base URL as Claude Code uses it (ANTHROPIC_BASE_URL), e.g. https://<gateway-host>
GATEWAY_URL=
# A command that prints a valid gateway JWT on stdout. Default: the client's `aigw_claude_auth.py token`, which uses
# the client's config and sign-in (~/.config/aigw-claude-auth, or AIGW_CLAUDE_AUTH_DIR).
TOKEN_COMMAND=
# Extra headers on every request to the real gateway, `Name: value` pairs separated by `;`, e.g.
# 'x-portkey-config: <config id>' (quoted) when the passthrough config is neither bound to the JWT nor the workspace default.
GATEWAY_EXTRA_HEADERS=
# Where the client keeps its config and sign-in, if not the default (client_live, and TOKEN_COMMAND's default).
AIGW_CLAUDE_AUTH_DIR=

# on: the load balancer guard rules (README, "Optional: answer token problems at the load balancer") are deployed in
# front of GATEWAY_URL; the gateway and live_login scenarios then expect 498 for the sentinel and a missing header.
LB_GUARD=off
SENTINEL=expired
